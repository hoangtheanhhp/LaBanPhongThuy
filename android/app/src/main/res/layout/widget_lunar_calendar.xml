<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lunar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thứ Tư, 07/10/2026"
            android:textColor="#C49A6C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_hoang_dao_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tag_red"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Hoàng Đạo"
            android:textColor="#FFB4AB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Big Lunar Day number box -->
        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_inner_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÂM LỊCH"
                android:textColor="#8D6E53"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27"
                android:textColor="#FAF6EE"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lunar_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng 8"
                android:textColor="#C49A6C"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Can Chi & Direction info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_can_chi_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày Canh Tý · Tháng Quý Dậu"
                android:textColor="#FAF6EE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_can_chi_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Năm Bính Ngọ · Tiết Hàn Lộ"
                android:textColor="#A89F91"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hoang_dao_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Giờ HĐ: Tý, Sửu, Mão, Ngọ, Thân, Dậu"
                android:textColor="#C49A6C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
