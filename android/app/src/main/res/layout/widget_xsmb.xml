<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_xsmb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XỔ SỐ MIỀN BẮC (XSMB)"
            android:textColor="#C49A6C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_xsmb_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06/10/2026"
            android:textColor="#A89F91"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Content Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Special Prize Big Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/widget_inner_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GIẢI ĐẶC BIỆT"
                android:textColor="#FFB4AB"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_xsmb_special"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12554"
                android:textColor="#FF897D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_xsmb_special_tail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 số cuối: 54"
                android:textColor="#FAF6EE"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Prize 1 & Head/Tail summary -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giải Nhất:"
                android:textColor="#A89F91"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_xsmb_prize1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26733"
                android:textColor="#FAF6EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_xsmb_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chạm để xem bảng Lô &amp; Thống kê"
                android:textColor="#C49A6C"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
